__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/

# ===== 打包 =====
build/
dist/
*.spec

# ===== 启动器（构建产物 + 本机绝对路径，不入库；默认输出在项目根）=====
/ScholarScout.exe
