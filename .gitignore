# ===== 本地数据与运行产物（绝不入库）=====
data/
run/
*.db
*.db-wal
*.db-shm

# ===== 密钥 =====
.env
*.env
!.env.example
# 本机配置（照 docs 的 `cp config.example.yaml config.yaml` 用法：仓库只跟踪 example）
config.yaml

# ===== Python =====
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/

# ===== 打包 =====
build/
dist/
# 自包含 Windows 包（`scripts/build_bundle.py` 的产物：解释器+依赖，几十~几百 MB，不入库）
ScholarScout-Portable/
*.spec

# ===== 启动器（构建产物 + 本机绝对路径，不入库；默认输出在项目根）=====
/ScholarScout.exe
/ScholarScout.launcher.ini
/launcher-diagnose.txt
/_wip/
# 论文成品（由 scripts/build_thesis_docx.py 从 docs/*.md 生成，不入库）
/*.docx
/*.pdf

# ===== 本地技能库的隐藏记账（不入库，但要留一份"为什么"）=====
# `skills/` 本身入库（那 130 篇 SKILL.md 随仓库分发，`skill.list` / `skill.load` 读它）；
# 但同目录下的点号条目是技能管理工具自己的账：`.archive` 是已归档的旧技能、
# `.hub/index-cache/hermes-index.json` 一个文件就 49MB、`.curator_backups` 是几 MB 的旧快照。
# 索引层（`skills/index.py`）也按同一规则跳过点号目录 —— 两边口径一致。
skills/.*

# ===== 编辑器 / 系统 =====
.vscode/
.idea/
Thumbs.db
Desktop.ini

# ===== 评测报告（数字随运行时间变，不入库；论文只引用文件名）=====
eval/reports/
