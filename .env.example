# 复制为 .env 后填写。.env 永不入库（.gitignore 已挡）。
# 这里只放密钥；其他设置一律进 config.yaml（照 Hermes 的做法：设置与密钥分离）。

# DeepSeek（推荐，便宜且中文好）
LLM_API_KEY=
# LLM_BASE_URL / LLM_MODEL 的开发期覆盖，留空则用 config.yaml 的值
LLM_BASE_URL=
LLM_MODEL=

# 本地 Ollama 免密钥跑法（开发自测用）：
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_API_KEY=ollama
#   LLM_MODEL=modelscope.cn/Qwen/Qwen2.5-3B-Instruct-GGUF:latest

# 通用搜索（v0.1 未实现，留位）
# TAVILY_API_KEY=
# SERPER_API_KEY=
