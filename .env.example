# 复制为 .env 后填写。.env 永不入库（.gitignore 已挡）。
# 这里只放密钥；其他设置一律进 config.yaml（照 Hermes 的做法：设置与密钥分离）。

# DeepSeek（推荐，便宜且中文好）
LLM_API_KEY=
# LLM_BASE_URL / LLM_MODEL 的开发期覆盖，留空则用 config.yaml 的值
LLM_BASE_URL=
LLM_MODEL=

# 本地 Ollama 免密钥跑法（开发自测用）：
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_API_KEY=ollama
#   LLM_MODEL=modelscope.cn/Qwen/Qwen2.5-3B-Instruct-GGUF:latest

# MinerU 官方 API（扫描版/复杂版式 PDF 解析，见 docs/04 §7）
# 免登录的 Agent 轻量接口不需要 token；精准解析接口需要，在 https://mineru.net/apiManage 创建
MINERU_API_TOKEN=

# 商用通用检索（可选；填了哪个就自动启用哪个来源，未填的在 provider_status 里报 missing_api_key）
# Tavily：为 LLM 设计的商用搜索，返回带摘要的 JSON（https://tavily.com）
TAVILY_API_KEY=
# Serper：Google SERP 的商用代理，按次计费（https://serper.dev）
SERPER_API_KEY=
# Brave Search API：独立索引，有免费额度（https://brave.com/search/api/）
BRAVE_API_KEY=
